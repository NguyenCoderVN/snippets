{
  "Check Sum of Digits is Prime": {
    "prefix": "f_isdigitsumprime",
    "body": [
      "bool isDigitSumPrime(long long n) {",
      "\tif (n < 0) n = -n;",
      "\tlong long sum = 0;",
      "\twhile (n > 0) {",
      "\t\tsum += n % 10;",
      "\t\tn /= 10;",
      "\t}",
      "\treturn isPrime(sum);",
      "}"
    ],
    "description": "Check if the sum of all digits of a number is prime"
  },
  "Check Perfect Square": {
    "prefix": "f_isperfectsquare",
    "body": [
      "bool isPerfectSquare(long long n) {",
      "\tif (n < 0)",
      "\t\treturn false;",
      "\tif (n == 0 || n == 1)",
      "\t\treturn true;",
      "",
      "\tlong long x = n;",
      "\tlong long y = (x + n / x) / 2;",
      "",
      "\twhile (y < x) {",
      "\t\tx = y;",
      "\t\ty = (x + n / x) / 2;",
      "\t}",
      "",
      "\treturn (n / x == x && n % x == 0);",
      "}"
    ],
    "description": "Check if a number is a perfect square using Newton's integer square root method"
  },
