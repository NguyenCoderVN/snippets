  "For Loop (Reverse)": {
    "prefix": "forsub",
    "body": [
      "for (int ${1:i} = ${2:n}; ${1:i} >= 1; ${1:i}--) {",
      "\t$0",
      "}"
    ],
    "description": "Vòng lặp for giảm dần từ n về 1"
  },
  "Check Prime": {
    "prefix": "isprime",
    "body": [
      "bool isPrime(int n) {",
      "\tfor (int i = 2; i * i <= n; i++)",
      "\t\tif (n % i == 0)",
      "\t\t\treturn false;",
      "",
      "\treturn n >= 2;",
      "}"
    ],
    "description": "Hàm kiểm tra số nguyên tố (O(sqrt(N)))"
  },
  "Check Prime Digits": {
    "prefix": "isprimedigit",
    "body": [
      "bool isPrimeDigit(int n) {",
      "\tfor (; n; n /= 10)",
      "\t\tif (!isPrime(n % 10))",
      "\t\t\treturn false;",
      "",
      "\treturn true;",
      "}"
    ],
    "description": "Hàm kiểm tra tất cả các chữ số có phải là số nguyên tố"
  }
