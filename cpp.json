   "Is Prime Function": {
    "prefix": "f_isprime",
    "body": [
      "bool isPrime(long long n) {",
      "  for (long long i = 2; i * i <= n; ++i) {",
      "    if (n % i == 0)",
      "      return false;",
      "  }",
      "  return n > 1;",
      "}"
    ],
    "description": "Khuôn mẫu kiểm tra số nguyên tố"
  },
  "Check Prime Digits": {
    "prefix": "f_isprimedigit",
    "body": [
      "bool isPrimeDigit(long long n) {",
      "    for (; n > 0; n /= 10) {",
      "        int digit = n % 10;",
      "        if (digit != 2 && digit != 3 && digit != 5 && digit != 7) return false;",
      "    }",
      "    return true;",
      "}"
    ],
    "description": "Check if all digits of a number are prime digits"
  },
  "Check Digits and Digit Sum Prime": {
    "prefix": "f_istotalprimedigit",
    "body": [
      "bool isTotalPrimeDigit(long long n) {",
      "    long long sum = 0;",
      "    for (long long temp = n; temp > 0; temp /= 10) {",
      "        int digit = temp % 10;",
      "        sum += digit;",
      "        if (digit != 2 && digit != 3 && digit != 5 && digit != 7) return false;",
      "    }",
      "    return isPrime(sum);",
      "}"
    ],
    "description": "Check if all digits and their sum are prime numbers"
  },
  "Check Digit Sum Prime": {
    "prefix": "f_isdigitsumprime",
    "body": [
      "bool isDigitSumPrime(long long n) {",
      "    if (n < 0) n = -n;",
      "    long long sum = 0;",
      "    while (n > 0) {",
      "        sum += n % 10;",
      "        n /= 10;",
      "    }",
      "    return isPrime(sum);",
      "}"
    ],
    "description": "Check if the sum of all digits of a number is prime"
  },
  "Check Palindrome": {
    "prefix": "f_ispalindrome",
    "body": [
      "bool isPalindromic(long long n) {",
      "    long long ans = 0;",
      "    long long temp = n;",
      "    while (temp > 0) {",
      "        ans = 10 * ans + temp % 10;",
      "        temp /= 10;",
      "    }",
      "    return (ans == n);",
      "}"
    ],
    "description": "Check if an integer is a palindrome"
  },
  "Check Perfect Square": {
    "prefix": "f_isperfectsquare",
    "body": [
      "#include <cmath>",
      "",
      "bool isPerfectSquare(long long n) {",
      "    if (n < 0) return false;",
      "    long long sq = std::sqrt(n);",
      "    return sq * sq == n;",
      "}"
    ],
    "description": "Check if a number is a perfect square"
  },
  "GCD Recursive": {
    "prefix": "f_gcd",
    "body": [
      "long long gcdRecursive(long long a, long long b) {",
      "    return (b == 0) ? a : gcdRecursive(b, a % b);",
      "}"
    ],
    "description": "Calculate Greatest Common Divisor (GCD) recursively"
