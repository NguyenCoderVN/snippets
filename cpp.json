  "Binary Exponentiation": {
    "prefix": "binpow",
    "description": "Binary Exponentiation (Modulo 10^9 + 7)",
    "body": [
      "const long long mod = 1e9 + 7;",
      "long long binpow(long long a, long long n) {",
      "\tlong long res = 1;",
      "\ta = (a % mod + mod) % mod;",
      "\twhile (n > 0) {",
      "\t\tif (n & 1) {",
      "\t\t\tres = (res * a) % mod;",
      "\t\t}",
      "\t\ta = (a * a) % mod;",
      "\t\tn >>= 1;",
      "\t}",
      "\treturn res;",
      "}"
    ]
  },
    
  "Sieve of Eratosthenes (Composite)": {
    "prefix": "composite",
    "body": [
      "bool isComposite[1000005] = {true, true};",
      "",
      "void composite() {",
      "    for (int i = 2; i * i <= 1000000; ++i) {",
      "        if (!isComposite[i]) {",
      "            for (int j = i * i; j <= 1000000; j += i) {",
      "                isComposite[j] = true;",
      "            }",
      "        }",
      "    }",
      "}"
    ],
    "description": "Sieve of Eratosthenes (mark composite numbers)"
