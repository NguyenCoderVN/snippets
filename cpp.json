  "Count and Print Frequencies": {
    "prefix": "freqCount",
    "body": [
      "template <typename T>",
      "vector<pair<T, int>> countFrequencies(vector<T>& v, string order = \"none\") {",
      "    vector<pair<T, int>> freqList;",
      "",
      "    for (const auto &x : v) {",
      "        bool found = false;",
      "        for (auto &p : freqList) {",
      "            if (p.first == x) {",
      "                p.second++;",
      "                found = true;",
      "                break;",
      "            }",
      "        }",
      "        if (!found) {",
      "            freqList.push_back({x, 1});",
      "        }",
      "    }",
      "",
      "    if (order == \"asc\") {",
      "        sort(freqList.begin(), freqList.end(), [](const pair<T, int>& a, const pair<T, int>& b) {",
      "            return a.first < b.first;",
      "        });",
      "    } else if (order == \"desc\") {",
      "        sort(freqList.begin(), freqList.end(), [](const pair<T, int>& a, const pair<T, int>& b) {",
      "            return a.first > b.first;",
      "        });",
      "    }",
      "",
      "    return freqList;",
      "}",
      "",
      "template <typename T>",
      "void printFrequencies(const vector<pair<T, int>>& freqList) {",
      "    for (const auto &p : freqList) {",
      "        cout << \"(\" << p.first << \", \" << p.second << \")\\n\";",
      "    }",
      "}"
    ],
    "description": "Hàm đếm và in tần suất xuất hiện các phần tử trong vector C++"
  },
  "Cout Vector Function": {
    "prefix": "f_coutvec",
    "body": [
      "template <typename T>",
      "void cout_vector(vector<T> &v, string para = \"\") {",
      "  if (v.empty()) {",
      "    cout << \"EMPTY\\n\";",
      "    return;",
      "  }",
      "",
      "  if (para == \"up\")",
      "    sort(v.begin(), v.end());",
      "  else if (para == \"down\")",
      "    sort(v.begin(), v.end(), greater<T>());",
      "  else if (para == \"rev\")",
      "    reverse(v.begin(), v.end());",
      "  else if (para == \"max\") {",
      "    cout << *max_element(v.begin(), v.end()) << '\\n';",
      "    return;",
      "  } else if (para == \"min\") {",
      "    cout << *min_element(v.begin(), v.end()) << '\\n';",
      "    return;",
      "  } else if (para == \"sum\") {",
      "    cout << accumulate(v.begin(), v.end(), T{}) << '\\n';",
      "    return;",
      "  }",
      "",
      "  for (auto it = v.begin(); it != v.end(); ++it)",
      "    cout << *it << (it == v.end() - 1 ? \"\" : \" \");",
      "",
      "  cout << '\\n';",
      "}"
    ],
    "description": "Hàm template xuất và xử lý vector"
  },
