  "Prime Factorization using SPF": {
    "prefix": "spf_factorize",
    "body": [
      "#include <iostream>",
      "#include <vector>",
      "",
      "using namespace std;",
      "",
      "vector<int> getSPF(int N) {",
      "    vector<int> spf(N + 1);",
      "",
      "    for (int i = 1; i <= N; i++) {",
      "        spf[i] = i;",
      "    }",
      "",
      "    for (int i = 2; i * i <= N; i++) {",
      "        if (spf[i] == i) {",
      "            for (int j = i * i; j <= N; j += i) {",
      "                if (spf[j] == j) {",
      "                    spf[j] = i;",
      "                }",
      "            }",
      "        }",
      "    }",
      "    return spf;",
      "}",
      "",
      "int main() {",
      "    int max_val = 2000;",
      "    vector<int> prime = getSPF(max_val);",
      "",
      "    int a[] = {60, 30, 20, 17, 15, 100, 2000, 28};",
      "    int n = sizeof(a) / sizeof(a[0]);",
      "",
      "    for (int i = 0; i < n; i++) {",
      "        cout << a[i] << \" = \";",
      "        int temp = a[i];",
      "        while (temp != 1) {",
      "            cout << prime[temp] << \" \";",
      "            temp /= prime[temp];",
      "        }",
      "        cout << \"\\n\";",
      "    }",
      "",
      "    return 0;",
      "}"
    ],
    "description": "Prime Factorization using Smallest Prime Factor (SPF) sieve algorithm"
  },
  "Segmented Sieve": {
    "prefix": "segmentedsieve",
    "body": [
      "#include <cmath>",
      "#include <iostream>",
      "#include <vector>",
      "using namespace std;",
      "using ll = long long;",
      "",
      "void segmentedSieve(ll L, ll R) {",
      "  ll lim = sqrt(R);",
      "  vector<bool> mark(lim + 1, true);",
      "  vector<ll> primes;",
      "  for (ll i = 2; i <= lim; i++) {",
      "    if (mark[i]) {",
      "      primes.push_back(i);",
      "      for (ll j = i * i; j <= lim; j += i)",
      "        mark[j] = false;",
      "    }",
      "  }",
      "",
      "  vector<bool> isPrime(R - L + 1, true);",
      "  for (ll p : primes) {",
      "    for (ll j = max(p * p, (L + p - 1) / p * p); j <= R;",
      "         j += p) {",
      "      isPrime[j - L] = false;",
      "    }",
      "  }",
      "",
      "  for (ll i = max(2LL, L); i <= R; i++) {",
      "    if (isPrime[i - L])",
      "      cout << i << ' ';",
      "  }",
      "}"
    ],
    "description": "Segmented Sieve Algorithm"
  },
