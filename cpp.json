  "Check Prime": {
    "prefix": "f_isprime",
    "body": [
      "bool isPrime(int n) {",
      "\tfor (int i = 2; i * i <= n; i++)",
      "\t\tif (n % i == 0)",
      "\t\t\treturn false;",
      "",
      "\treturn n >= 2;",
      "}"
    ],
    "description": "Check if a number is prime (O(sqrt(N)))"
  },
  "Check Prime Digits": {
    "prefix": "f_isprimedigit",
    "body": [
      "bool isPrimeDigit(long long n) {",
      "\tfor (; n > 0; n /= 10) {",
      "\t\tif (!isPrime(n % 10)) return false;",
      "\t}",
      "\treturn true;",
      "}"
    ],
    "description": "Check if all digits of a number are prime digits"
  },
  "Check Digits and Digit Sum Prime": {
    "prefix": "f_istotalprimedigit",
    "body": [
      "bool isTotalPrimeDigit(long long n) {",
      "\tlong long sum = 0;",
      "\tfor (long long temp = n; temp > 0; temp /= 10) {",
      "\t\tint digit = temp % 10;",
      "\t\tsum += digit;",
      "\t\tif (!isPrime(digit)) return false;",
      "\t}",
      "\treturn isPrime(sum);",
      "}"
    ],
    "description": "Check if all digits and their sum are prime numbers"
  },
  "Check Digit Sum Prime": {
    "prefix": "f_isdigitsumprime",
    "body": [
      "bool isDigitSumPrime(long long n) {",
      "\tif (n < 0) n = -n;",
      "\tlong long sum = 0;",
      "\twhile (n > 0) {",
      "\t\tsum += n % 10;",
      "\t\tn /= 10;",
      "\t}",
      "\treturn isPrime(sum);",
      "}"
    ],
    "description": "Check if the sum of all digits of a number is prime"
  },
  "Check Palindrome": {
    "prefix": "f_ispalindrome",
    "body": [
      "bool isPalindromic(int n) {",
      "\tlong long ans = 0;",
      "\tint temp = n;",
      "\twhile (temp > 0) {",
      "\t\tans = 10 * ans + temp % 10;",
      "\t\ttemp /= 10;",
      "\t}",
      "\treturn (ans == n);",
      "}"
    ],
    "description": "Check if an integer is a palindrome"
  },
  "Check Perfect Square": {
    "prefix": "f_isperfectsquare",
    "body": [
      "bool isPerfectSquare(long long n) {",
      "\tif (n < 0)",
      "\t\treturn false;",
      "\tif (n == 0 || n == 1)",
      "\t\treturn true;",
      "",
      "\tlong long x = n;",
      "\tlong long y = (x + n / x) / 2;",
      "",
      "\twhile (y < x) {",
      "\t\tx = y;",
      "\t\ty = (x + n / x) / 2;",
      "\t}",
      "",
      "\treturn (n / x == x && n % x == 0);",
      "}"
    ],
    "description": "Check if a number is a perfect square using Newton's method"
  },
  "GCD Recursive": {
    "prefix": "f_gcd",
    "body": [
      "long long gcdRecursive(long long a, long long b) {",
      "\ta = std::abs(a);",
      "\tb = std::abs(b);",
      "\treturn (b == 0) ? a : gcdRecursive(b, a % b);",
      "}"
    ],
    "description": "Calculate Greatest Common Divisor (GCD) recursively"
  },
