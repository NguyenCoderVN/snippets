  "Check Prime": {
    "prefix": "f_isprime",
    "body": [
      "bool isPrime(long long n) {",
      "\tif (n < 2) return false;",
      "\tfor (long long i = 2; i * i <= n; i++) {",
      "\t\tif (n % i == 0) return false;",
      "\t}",
      "\treturn true;",
      "}"
    ],
    "description": "Hàm kiểm tra số nguyên tố O(sqrt(N))"
  },
  "Check Prime Digits": {
    "prefix": "f_isprimedigit",
    "body": [
      "bool isPrimeDigit(long long n) {",
      "\tfor (; n > 0; n /= 10) {",
      "\t\tif (!isPrime(n % 10)) return false;",
      "\t}",
      "\treturn true;",
      "}"
    ],
    "description": "Kiểm tra tất cả chữ số là số nguyên tố"
  },
  "Check Total Prime Digits": {
    "prefix": "f_istotalprimedigit",
    "body": [
      "bool isTotalPrimeDigit(long long n) {",
      "\tlong long sum = 0;",
      "\tfor (long long temp = n; temp > 0; temp /= 10) {",
      "\t\tint digit = temp % 10;",
      "\t\tsum += digit;",
      "\t\tif (!isPrime(digit)) return false;",
      "\t}",
      "\treturn isPrime(sum);",
      "}"
    ],
    "description": "Kiểm tra từng chữ số và tổng các chữ số đều là số NT"
  },
