 "Check Prime (Short)": {
    "prefix": "f_isprime",
    "body": [
      "bool isPrime(int n) {",
      "\tfor (int i = 2; i * i <= n; i++)",
      "\t\tif (n % i == 0)",
      "\t\t\treturn false;",
      "",
      "\treturn n >= 2;",
      "}"
    ],
    "description": "Short prime check function (O(sqrt(N)))"
  },
  "Check Prime Digits": {
    "prefix": "f_isprimedigit",
    "body": [
      "bool isPrimeDigit(long long n) {",
      "\tfor (; n > 0; n /= 10) {",
      "\t\tif (!isPrime(n % 10)) return false;",
      "\t}",
      "\treturn true;",
      "}"
    ],
    "description": "Kiểm tra tất cả chữ số là số nguyên tố"
  },
  "Check Total Prime Digits": {
    "prefix": "f_istotalprimedigit",
    "body": [
      "bool isTotalPrimeDigit(long long n) {",
      "\tlong long sum = 0;",
      "\tfor (long long temp = n; temp > 0; temp /= 10) {",
      "\t\tint digit = temp % 10;",
      "\t\tsum += digit;",
      "\t\tif (!isPrime(digit)) return false;",
      "\t}",
      "\treturn isPrime(sum);",
      "}"
    ],
    "description": "Kiểm tra từng chữ số và tổng các chữ số đều là số NT"
  },
  "Check Palindrome Number": {
    "prefix": "f_ispalindrome",
    "body": [
      "bool isPalindromic(int n) {",
      "\tlong long ans = 0;",
      "\tint temp = n;",
      "\twhile (temp > 0) {",
      "\t\tans = 10 * ans + temp % 10;",
      "\t\ttemp /= 10;",
      "\t}",
      "\treturn (ans == n);",
      "}"
    ],
    "description": "Check if an integer is a palindrome (overflow-safe with long long)"
  },
  "GCD Recursive": {
    "prefix": "f_gcd",
    "body": [
      "long long gcdRecursive(long long a, long long b) {",
      "\ta = std::abs(a);",
      "\tb = std::abs(b);",
      "\treturn (b == 0) ? a : gcdRecursive(b, a % b);",
      "}"
    ],
    "description": "Hàm tìm UCLN (GCD)"
