  "For Loop (Start at 1)": {
    "prefix": "foradd",
    "body": [
      "for (int ${1:i} = 1; ${1:i} <= ${2:n}; ${1:i}++) {",
      "\t$0",
      "}"
    ],
    "description": "Vòng lặp for bắt đầu từ 1 đến n"
