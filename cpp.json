      "#include <algorithm>",
      "#include <iostream>",
      "#include <numeric>",
      "#include <string>",
      "#include <vector>",
      "",
      "using namespace std;",
      "",
      "void cout_vector(vector<int> &v, string para = \"\") {",
      "\tif (v.empty()) {",
      "\t\tcout << \"EMPTY\\n\";",
      "\t\treturn;",
      "\t}",
      "",
      "\tif (para == \"up\")",
      "\t\tsort(v.begin(), v.end());",
      "\telse if (para == \"down\")",
      "\t\tsort(v.begin(), v.end(), greater<int>());",
      "\telse if (para == \"rev\")",
      "\t\treverse(v.begin(), v.end());",
      "\telse if (para == \"max\") {",
      "\t\tcout << *max_element(v.begin(), v.end()) << '\\n';",
      "\t\treturn;",
      "\t} else if (para == \"min\") {",
      "\t\tcout << *min_element(v.begin(), v.end()) << '\\n';",
      "\t\treturn;",
      "\t} else if (para == \"sum\") {",
      "\t\tcout << accumulate(v.begin(), v.end(), 0) << '\\n';",
      "\t\treturn;",
      "\t}",
      "",
      "\tfor (auto it = v.begin(); it != v.end(); ++it)",
      "\t\tcout << *it << ' ';",
      "",
      "\tcout << '\\n';",
      "}",
      "",
      "/**",
      " * TODO: $0",
      " */",
      "int main() {",
      "\tios_base::sync_with_stdio(false);",
      "\tcin.tie(NULL);",
      "",
      "\tint n;",
      "\tcin >> n;",
      "\tvector<int> v(n);",
      "\tfor (int i = 0; i < n; i++)",
      "\t\tcin >> v[i];",
      "",
      "\tcout_vector(v);",
      "",
      "\treturn 0;",
      "}"
    ]
